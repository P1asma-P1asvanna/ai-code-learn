# ===== Backend (FastAPI) =====
APP_ENV=dev
DATABASE_URL=postgresql://app:app@localhost:5432/ailearn
JWT_SECRET=dev-only-secret-change-me-before-deploy-1234567890
CORS_ORIGINS=http://localhost:3000
AUTO_CREATE_TABLES=true
AUTO_SEED=true

# ===== AI ตรวจโค้ด (ไม่ใส่ AI_API_KEY = ปิดฟีเจอร์นี้) =====
# ใช้ provider ไหนก็ได้ที่เข้ากับ OpenAI chat completions เปลี่ยนแค่ 3 บรรทัดนี้
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# ใส่ได้หลายชื่อคั่นด้วย , ถ้าชื่อแรกใช้ไม่ได้ (404) จะลองชื่อถัดไปเอง
AI_MODEL=gemini-flash-lite-latest,gemini-flash-latest,gemini-3.1-flash-lite
# ตัวอย่างอื่น:
#   Groq:       AI_BASE_URL=https://api.groq.com/openai/v1
#   OpenRouter: AI_BASE_URL=https://openrouter.ai/api/v1
#   Ollama:     AI_BASE_URL=http://localhost:11434/v1  (รันบนเครื่องตัวเอง)
